# Port HTTP de l'API
PORT=4000

# Connexion PostgreSQL (port 5434 = mapping Docker, hors conflit avec le Postgres local 5432 et autres conteneurs)
DATABASE_URL=postgres://nova:nova@localhost:5434/nova_dev

# Secret JWT — à remplacer en production (64 octets recommandés)
# Le démarrage est refusé en production si < 32 caractères ou valeur par défaut.
JWT_SECRET=change-me-in-production-minimum-64-random-characters-please
JWT_EXPIRES_IN=7d

# Origine autorisée pour le navigateur
CORS_ORIGIN=http://localhost:5173

# Paiement Stripe — laisser vide pour le mode démo (paiement simulé).
# Renseigner les trois clés de test pour activer le vrai flux (PaymentElement + webhooks).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Notifications & emails
# MAIL_DRIVER=log   -> emails écrits dans backend/logs/mail.log (dev)
# MAIL_DRIVER=smtp  -> envoi réel via SMTP (nodemailer), compléter ci-dessous
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# MAIL_FROM=NOVA <no-reply@nova-bienetre.fr>
# APP_URL=http://localhost:5173
# REMINDER_INTERVAL_MIN=15  # fréquence du job de rappel de rendez-vous (J-1)

# Compte administrateur de démonstration (npm run db:seed-admin)
# ADMIN_SEED_EMAIL=admin@nova.fr
# ADMIN_SEED_PASSWORD=admin123
# ADMIN_SEED_FIRST_NAME=Nina
# ADMIN_SEED_LAST_NAME=Nova

NODE_ENV=development