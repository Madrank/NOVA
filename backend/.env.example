# Port HTTP de l'API
PORT=4000

# Connexion PostgreSQL (port 5434 = mapping Docker, hors conflit avec le Postgres local 5432 et autres conteneurs)
DATABASE_URL=postgres://nova:nova@localhost:5434/nova_dev

# Secret JWT — à remplacer en production (64 octets recommandés)
JWT_SECRET=change-me-in-production-minimum-64-random-characters-please
JWT_EXPIRES_IN=7d

# Origine autorisée pour le navigateur
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development